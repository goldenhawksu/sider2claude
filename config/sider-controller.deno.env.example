# 已实测Opus/Sonnet5.5文本工具契约和StoreContent→WriteFromRef。
# 将这些变量叠加到Deno部署配置；凭证沿用项目已有配置。
SIDER_CONTROLLER=true
# Deno流式默认走混合路由；需要主控接管时显式开启，套件14/15覆盖此路径。
SIDER_CONTROLLER_STREAMING=false
SIDER_CONTROLLER_STORAGE=kv
# 本地默认写入.runtime；Deno Deploy保持未设，使用关联的Deno KV。
# 仅本地使用；Deploy不要设置此路径，否则不会使用关联的平台KV。
# SIDER_CONTROLLER_KV_PATH=.runtime/controller.sqlite
SIDER_REQUEST_TIMEOUT_MS=300000
SIDER_TOTAL_TIMEOUT_MS=600000
# 默认只使用目前已实测通过的单轮体量附近，超限保留检查点并返回413。
SIDER_CONTROLLER_MAX_INPUT_CHARS=6000
SIDER_CONTROLLER_PACE_MS=12000
DEFAULT_BACKEND=sider
AUTO_FALLBACK=false
STATS_KV=kv
# STATS_KV_PATH=.runtime/stats.sqlite
DEEPSEEK_BASE_URL=https://api.z.ai/api/anthropic
DEEPSEEK_MODEL=glm-5.3-flash
# 即使关闭业务AUTO_FALLBACK，已配置的兼容后端仍处理无工具XML安全分类。
# SIDER_AUTH_TOKEN、AUTH_TOKEN、DEEPSEEK_API_KEY在部署机密中提供，不写进样例。
