# Bun通过SQLite保存主控任务、内容引用及账号租约。
SIDER_CONTROLLER=true
SIDER_CONTROLLER_STORAGE=sqlite
SIDER_REQUEST_TIMEOUT_MS=300000
SIDER_TOTAL_TIMEOUT_MS=600000
SIDER_CONTROLLER_MAX_INPUT_CHARS=14000
SIDER_CONTROLLER_PACE_MS=12000
DEFAULT_BACKEND=sider
AUTO_FALLBACK=false
DEEPSEEK_BASE_URL=https://api.z.ai/api/anthropic
DEEPSEEK_MODEL=glm-5.3-flash
# 运行目录必须可写，数据库位于.runtime/controller.sqlite。
# SIDER_AUTH_TOKEN、AUTH_TOKEN、DEEPSEEK_API_KEY由环境变量或现有deno/.env提供。
