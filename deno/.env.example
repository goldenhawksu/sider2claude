# ============================================
# Sider2Claude 环境配置示例
# ============================================

# ============= 服务器配置 =============
PORT=4141
NODE_ENV=development
LOG_LEVEL=info

# ============= 客户端认证配置 =============
# AUTH_TOKEN: 客户端使用的认证 Token（必填；未配置时所有受保护请求返回 503）
AUTH_TOKEN=your-custom-auth-token-here

# ADMIN_TOKEN: 管理操作（/stats/strategy 切换策略）凭证；不填时回退 AUTH_TOKEN
# ADMIN_TOKEN=your-admin-token
# STATS_TOKEN: 只读看板凭证；AUTH_TOKEN 与 ADMIN_TOKEN 也可读看板
# STATS_TOKEN=your-stats-token
# STATS_PUBLIC=true 时 /stats、/stats.json、/stats/telemetry.json 不需要凭证（不建议公网使用）
# STATS_PUBLIC=false
# ALLOW_OPEN_AUTH=true 时，未配置 AUTH_TOKEN 也接受任意 ≥10 字符 token（仅限本地开发）
# ALLOW_OPEN_AUTH=false
# SIDER_TOKEN_PASSTHROUGH=true 时，未配置 SIDER_AUTH_TOKEN 会把客户端 token 当 Sider 凭证使用
# SIDER_TOKEN_PASSTHROUGH=false
# 主控流式请求的提交窗口（毫秒）：首个内容产出前失败时返回 HTTP 错误与 Retry-After；0 为立即开流
# SIDER_CONTROLLER_STREAM_COMMIT_MS=20000
# 请求体上限（字节），默认 33554432（32 MB，与 Anthropic API 一致）
# MAX_REQUEST_BODY_BYTES=33554432

# ============= Sider AI 配置（普通对话上游）=============
SIDER_API_URL=https://sider.ai/api/chat/v1/completions
SIDER_AUTH_TOKEN=your-sider-jwt

# ============= DeepSeek 配置（工具能力兜底上游）=============
# 统一走 DEEPSEEK_* 一套配置，没有 ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY。
# DEEPSEEK_BASE_URL 可指向任意 Anthropic 兼容端：要用 Z.AI 的 GLM-5.3，只需把
# 下面三项改成 Z.AI 的入口 / key / 模型名，其余不用动。
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash

# ============= 路由配置 =============
DEFAULT_BACKEND=sider
AUTO_FALLBACK=true
PREFER_SIDER_FOR_CHAT=true
DEBUG_ROUTING=false

# 超过此体量的请求不投 Sider（实测 44K 字符会被 code 603 硬拒）
# 仅 SIDER_STRATEGY=conservative 时生效
SIDER_MAX_INPUT_CHARS=30000

# Sider 投递策略三档：conservative（默认）/ pro / max
SIDER_STRATEGY=conservative

# ============= 其他配置 =============
REQUEST_TIMEOUT=30000

# ============= 场景说明 =============
# 场景 1: 只使用 Sider AI
# - 配置 SIDER_AUTH_TOKEN，不配置 DEEPSEEK_API_KEY
# - 结果: 只有普通对话可用，工具调用不可用

# 场景 2: 只使用 DeepSeek
# - 不配置 SIDER_AUTH_TOKEN，配置 DEEPSEEK_API_KEY
# - 结果: 所有请求都走 DeepSeek

# 场景 3: 混合使用（推荐）
# - 同时配置 SIDER_AUTH_TOKEN 和 DEEPSEEK_API_KEY
# - 结果: 普通对话走 Sider（包年订阅边际成本 0），工具调用走 DeepSeek
